# Release builds must use https — the app refuses to start otherwise (src/api/client.ts).
# For a local device/emulator against your dev machine, use your LAN IP rather than
# localhost, e.g. http://192.168.1.20:8080/api (Android emulator: http://10.0.2.2:8080/api).
EXPO_PUBLIC_API_BASE_URL=https://api.your-domain.com/api
